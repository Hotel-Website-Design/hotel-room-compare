{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hotel Room Compare example structure",
  "description": "Structural guide to the supplied example. Runtime validation enforces supported states, publication gates and cross-field rules.",
  "type": "object",
  "properties": {
    "hotel": {
      "type": "string"
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "occupancy": {
            "type": "number"
          },
          "beds": {
            "type": "string"
          },
          "size": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "amenities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "access_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "booking_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "contact_note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "occupancy",
          "beds",
          "size",
          "amenities",
          "access_note",
          "booking_url",
          "contact_note"
        ]
      }
    }
  },
  "required": [
    "hotel",
    "rooms"
  ]
}
